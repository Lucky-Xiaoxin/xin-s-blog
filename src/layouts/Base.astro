---
import '@fontsource/bodoni-moda/400.css';
import '@fontsource/bodoni-moda/500.css';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { SITE, NAV, PAGE_LINKS, SOCIALS, resolveHref, u } from '../const';

interface Props {
  title?: string;
  description?: string;
  active?: string;
  /** full = 首页的大字页头；compact = 内页的窄页头 */
  size?: 'full' | 'compact';
  /** main 的内容壳宽度；页头/页脚固定 wide，翻页时品牌与导航不位移 */
  width?: 'measure' | 'mid' | 'wide';
  ogType?: 'website' | 'article';
}

const {
  title,
  description = SITE.description,
  active = '',
  size = 'full',
  width = 'measure',
  ogType = 'website',
} = Astro.props;

const contentShellClass = width === 'measure' ? 'shell' : `shell shell--${width}`;
// 站点 chrome 固定 wide：内容列可以窄，但品牌/导航/页脚不跟着页面换档
const chromeShellClass = 'shell shell--wide';

const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// trailingSlash: always 下 /404/ 不可达（Astro 固定输出扁平 404.html），
// 因此 404 页不写指向死地址的 canonical/og:url，并声明 noindex
const relPath = Astro.url.pathname.slice(
  (import.meta.env.BASE_URL || '/').replace(/\/$/, '').length,
);
const is404 = /^\/404\/?$/.test(relPath);
const ogImage = new URL(u('/og.png'), Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    {
      is404 ? (
        <meta name="robots" content="noindex" />
      ) : (
        <link rel="canonical" href={canonical} />
      )
    }
    <meta name="generator" content={Astro.generator} />
    {
      !is404 && (
        <>
          <meta property="og:type" content={ogType} />
          <meta property="og:title" content={pageTitle} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonical} />
          <meta property="og:site_name" content={SITE.title} />
          <meta property="og:image" content={ogImage} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <noscript>
      <meta name="theme-color" content="#111214" media="(prefers-color-scheme: dark)" />
      <style is:inline>.theme-toggle{display:none}</style>
    </noscript>
    <script is:inline>
      // 首屏应用明暗主题（必须留在 <head> 内联执行，否则刷新会先闪一下浅色）；
      // 无存储时跟随系统偏好，手动切换后由 localStorage 记忆。
      // 这里**永远显式写 light 或 dark**：属性一旦缺失，global.css 的「深色入口②」
      // （@media 无 JS 兜底）就会接管，系统暗色下用户选的亮色会被翻盘成暗色。
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('xin-s-blog-theme');
        } catch (e) {}
        var dark = stored
          ? stored === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
        // JS 可用时由脚本接管主题色：去掉 media 条件，避免手动选亮/暗后仍被系统偏好覆盖
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) {
          meta.removeAttribute('media');
          meta.setAttribute('content', dark ? '#111214' : '#ffffff');
        }
      })();
    </script>
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={u('/rss.xml')} />
    <link rel="icon" type="image/svg+xml" href={u('/favicon.svg')} />
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>

    <header class:list={['masthead', size === 'compact' && 'masthead--compact']}>
      <div class={chromeShellClass}>
        <div class="masthead__row">
          {
            size === 'full' ? (
              <h1 class="brand">
                <a href={u('/')}>{SITE.title}<span class="dot">.</span></a>
              </h1>
            ) : (
              <a class="brand" href={u('/')}>
                {SITE.title}<span class="dot">.</span>
              </a>
            )
          }
          <span class="masthead__handle label">{SITE.handle}</span>
        </div>
        {
          size === 'full' && (
            <p class="tagline">
              {SITE.tagline} · {SITE.description}
            </p>
          )
        }
        <div class="nav-bar">
          <nav class="nav" aria-label="主导航">
            {
              NAV.map((item) => (
                <a href={u(item.href)} aria-current={active === item.key ? 'page' : undefined}>
                  {item.label}
                </a>
              ))
            }
          </nav>
          <button
            class="theme-toggle"
            type="button"
            role="switch"
            aria-checked="false"
            aria-label="深色模式"
            title="切换到深色模式"
          >
            <svg class="theme-toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
            <svg class="theme-toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
              <circle cx="12" cy="12" r="4.6" />
              <path d="M12 1.6v2M12 20.4v2M1.6 12h2M20.4 12h2M4.7 4.7l1.4 1.4M17.9 17.9l1.4 1.4M19.3 4.7l-1.4 1.4M6.1 17.9l-1.4 1.4" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <div class={contentShellClass}>
        <slot />
      </div>
    </main>

    <footer class="colophon">
      <div class={chromeShellClass}>
        <div class="colophon__row label">
          <span>© {SITE.year} {SITE.author}</span>
          <nav class="colophon__nav" aria-label="页脚导航">
            {
              [...PAGE_LINKS, ...SOCIALS].map((s, i) => (
                <>
                  {i > 0 && <span class="sep">/</span>}
                  <a href={resolveHref(s.href)} rel={/^https?:/i.test(s.href) ? 'noopener' : undefined}>
                    {s.label}
                  </a>
                </>
              ))
            }
          </nav>
        </div>
      </div>
    </footer>

    <script>
      // 明暗主题切换：首屏状态由 <head> 内联脚本应用，这里负责点按切换与状态同步
      const root = document.documentElement;
      const toggle = document.querySelector('.theme-toggle');
      const meta = document.querySelector('meta[name="theme-color"]');

      if (toggle) {
        const sync = () => {
          const dark = root.getAttribute('data-theme') === 'dark';
          toggle.setAttribute('aria-checked', dark ? 'true' : 'false');
          toggle.setAttribute('title', dark ? '切换到浅色模式' : '切换到深色模式');
          meta?.setAttribute('content', dark ? '#111214' : '#ffffff');
        };

        toggle.addEventListener('click', () => {
          const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          // 不能 removeAttribute：属性缺失等于「没有 JS」，会被深色入口②接管
          root.setAttribute('data-theme', next);
          try {
            localStorage.setItem('xin-s-blog-theme', next);
          } catch {}
          sync();
        });

        sync();
      }
    </script>
  </body>
</html>
