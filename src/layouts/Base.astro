---
import '@fontsource/bodoni-moda/400.css';
import '@fontsource/bodoni-moda/400-italic.css';
import '@fontsource/bodoni-moda/500.css';
import '../styles/global.css';
import { SITE, NAV, SOCIALS, u } from '../const';

interface Props {
  title?: string;
  description?: string;
  active?: string;
  /** full = 首页的大字页头；compact = 内页的窄页头 */
  size?: 'full' | 'compact';
}

const {
  title,
  description = SITE.description,
  active = '',
  size = 'full',
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={u('/rss.xml')} />
    <link rel="icon" type="image/svg+xml" href={u('/favicon.svg')} />
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>

    <header class:list={['masthead', size === 'compact' && 'masthead--compact']}>
      <div class="shell">
        <div class="masthead__row">
          <a class="brand" href={u('/')}>
            {SITE.title}<span class="dot">.</span>
          </a>
          <span class="masthead__handle label">{SITE.handle}</span>
        </div>
        {
          size === 'full' && (
            <p class="tagline">
              {SITE.tagline} · {SITE.description}
            </p>
          )
        }
        <nav class="nav" aria-label="主导航">
          {
            NAV.map((item) => (
              <a href={u(item.href)} aria-current={active === item.key ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="main">
      <div class="shell">
        <slot />
      </div>
    </main>

    <footer class="colophon">
      <div class="shell">
        <div class="colophon__row label">
          <span>© {SITE.year} {SITE.author}</span>
          <span>
            {
              SOCIALS.map((s, i) => (
                <>
                  {i > 0 && <span class="sep">/</span>}
                  <a href={s.href} rel={s.href.startsWith('http') ? 'noopener' : undefined}>
                    {s.label}
                  </a>
                </>
              ))
            }
          </span>
        </div>
        <p class="colophon__note meta">Astro 构建 · GitHub Pages 托管 · 订阅 RSS</p>
      </div>
    </footer>
  </body>
</html>
