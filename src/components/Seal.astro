---
import { sealFor } from '../const';

interface Props {
  id: string;
  tag?: string;
  size?: number;
  class?: string;
}

const { id, tag, size = 48, class: className } = Astro.props;
const { shape, core } = sealFor(id, tag);

// 红点：内芯的特征点（环→圆顶、三角→顶尖上方、菱形→右顶点、十字→交点……）
const DOTS: Record<string, { x: number; y: number; r: number }> = {
  ring: { x: 12, y: 7, r: 1.2 },
  tri: { x: 12, y: 6.2, r: 1.2 },
  diamond: { x: 17, y: 12, r: 1.2 },
  cross: { x: 12, y: 12, r: 1.3 },
  diag: { x: 17.5, y: 6.5, r: 1.2 },
  axis: { x: 12, y: 8, r: 1.2 },
  hline: { x: 6.5, y: 15.5, r: 1.2 },
  orb: { x: 12, y: 11, r: 1.2 },
};

// 半圆框顶缘在 y=8，默认高位红点会越弧，按框压到框内
const FRAME_DOTS: Record<string, Record<string, { x: number; y: number; r: number }>> = {
  semicircle: {
    tri: { x: 12, y: 9.6, r: 1.2 },
    axis: { x: 12, y: 9.4, r: 1.2 },
  },
};
const dot = FRAME_DOTS[shape]?.[core] ?? DOTS[core];
---
---

<svg
  class:list={['seal', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
>
  {/* 外框：分类形状 */}
  {
    shape === 'triangle' && (
      <polygon data-frame vector-effect="non-scaling-stroke" points="12,3 21.5,20.5 2.5,20.5" />
    )
  }
  {
    shape === 'hexagon' && (
      <polygon
        data-frame
        vector-effect="non-scaling-stroke"
        points="12,2.5 20.2,7.25 20.2,16.75 12,21.5 3.8,16.75 3.8,7.25"
      />
    )
  }
  {
    shape === 'square' && (
      <rect data-frame vector-effect="non-scaling-stroke" x="3.5" y="3.5" width="17" height="17" />
    )
  }
  {
    shape === 'rhombus' && (
      <polygon
        data-frame
        vector-effect="non-scaling-stroke"
        points="12,2.5 21.5,12 12,21.5 2.5,12"
      />
    )
  }
  {
    shape === 'semicircle' && (
      <path
        data-frame
        vector-effect="non-scaling-stroke"
        d="M2.5 17.5 A9.5 9.5 0 0 1 21.5 17.5 Z"
      />
    )
  }
  {
    shape === 'circle' && (
      <circle data-frame vector-effect="non-scaling-stroke" cx="12" cy="12" r="9.5" />
    )
  }

  {/* 内芯：由文章哈希决定 */}
  {core === 'ring' && <circle data-core vector-effect="non-scaling-stroke" cx="12" cy="12" r="5" />}
  {
    core === 'tri' && (
      <polygon data-core vector-effect="non-scaling-stroke" points="12,9 17,17.5 7,17.5" />
    )
  }
  {
    core === 'diamond' && (
      <polygon data-core vector-effect="non-scaling-stroke" points="12,7 17,12 12,17 7,12" />
    )
  }
  {
    core === 'cross' && (
      <path data-core vector-effect="non-scaling-stroke" d="M12 7.5V16.5M7.5 12H16.5" />
    )
  }
  {core === 'diag' && <path data-core vector-effect="non-scaling-stroke" d="M6.5 17.5 17.5 6.5" />}
  {core === 'axis' && <path data-core vector-effect="non-scaling-stroke" d="M12 8.5V17.5" />}
  {core === 'hline' && <path data-core vector-effect="non-scaling-stroke" d="M6.5 15.5H17.5" />}
  {core === 'orb' && <circle data-core vector-effect="non-scaling-stroke" cx="12" cy="14" r="3" />}

  <circle class="seal__dot" cx={dot.x} cy={dot.y} r={dot.r} />
</svg>