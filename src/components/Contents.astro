---
import type { CollectionEntry } from 'astro:content';
import { formatDay, readingTime, u } from '../const';

interface Props {
  /** 全部已发布文章（已按发布时间倒序） */
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<!-- 目录：全部文章的编号清单 -->
{
  posts.length > 0 && (
    <section class="contents" aria-labelledby="contents-title">
      <header class="section-head">
        <h2 id="contents-title">目录</h2>
        <span class="meta">
          {pad(posts.length)} 篇 · 按时间倒序
        </span>
      </header>
      <ol class="toc">
        {posts.map((post, index) => (
          <li class="toc__item">
            <span class="toc__no">{pad(index + 1)}</span>
            <div>
              <h3>
                <a href={u(`/posts/${post.id}/`)}>{post.data.title}</a>
              </h3>
              <p>{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <div class="toc__foot">
                  <span class="tag-list">
                    {post.data.tags.map((tag) => (
                      <a class="tag" href={u(`/tags/${encodeURIComponent(tag)}/`)}>
                        {tag}
                      </a>
                    ))}
                  </span>
                </div>
              )}
            </div>
            <div class="toc__meta">
              <span class="meta">{formatDay(post.data.pubDate)}</span>
              <span class="meta">{readingTime(post.body)} 分钟</span>
            </div>
          </li>
        ))}
      </ol>
    </section>
  )
}
