---
import type { CollectionEntry } from 'astro:content';
import Badge from './Badge.astro';
import { formatDay, readingTime, u } from '../const';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
---

<ul class="index">
  {
    posts.map((post) => (
      <li class="index__item">
        <div class="index__badge">
          <Badge tag={post.data.tags[0]} />
        </div>
        <div>
          <h2 class="index__title">
            <a href={u(`/posts/${post.id}/`)}>{post.data.title}</a>
          </h2>
          <p class="index__desc">{post.data.description}</p>
          <div class="index__foot">
            <span class="meta">{formatDay(post.data.pubDate)}</span>
            <span class="meta">{readingTime(post.body)} 分钟</span>
            {post.data.tags.map((tag) => (
              <a class="tag" href={u(`/tags/${encodeURIComponent(tag)}/`)}>
                {tag}
              </a>
            ))}
          </div>
        </div>
      </li>
    ))
  }
</ul>
