---
import { shapeFor, type Shape } from '../const';

interface Props {
  tag?: string;
  shape?: Shape;
}

const { tag, shape = shapeFor(tag) } = Astro.props;
---

<span class="badge" aria-hidden="true">
  {
    shape === 'triangle' && (
      <svg viewBox="0 0 24 24">
        <polygon data-shape points="12,3 21.5,20.5 2.5,20.5" />
      </svg>
    )
  }
  {
    shape === 'hexagon' && (
      <svg viewBox="0 0 24 24">
        <polygon data-shape points="12,2.5 20.2,7.25 20.2,16.75 12,21.5 3.8,16.75 3.8,7.25" />
      </svg>
    )
  }
  {
    shape === 'square' && (
      <svg viewBox="0 0 24 24">
        <rect data-shape x="3.5" y="3.5" width="17" height="17" />
      </svg>
    )
  }
  {
    shape === 'rhombus' && (
      <svg viewBox="0 0 24 24">
        <polygon data-shape points="12,2.5 21.5,12 12,21.5 2.5,12" />
      </svg>
    )
  }
  {
    shape === 'semicircle' && (
      <svg viewBox="0 0 24 24">
        <path data-shape d="M2.5 17.5 A9.5 9.5 0 0 1 21.5 17.5 Z" />
      </svg>
    )
  }
  {
    shape === 'circle' && (
      <svg viewBox="0 0 24 24">
        <circle data-shape cx="12" cy="12" r="9.5" />
        <circle data-dot cx="12" cy="12" r="2" />
      </svg>
    )
  }
</span>
