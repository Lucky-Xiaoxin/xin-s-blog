---
import { formatMonthDay } from '../const';

interface Props {
  /** 已发布文章数 */
  postCount: number;
  /** 最新一篇的发布日期；没有文章时留空 */
  latestPostDate?: Date;
  /** 已发布碎碎念数 */
  noteCount: number;
  /** 最近一条碎碎念的日期；没有碎碎念时留空 */
  latestNoteDate?: Date;
  /** now 的一行状态；没有 now 时整格不渲染 */
  nowDescription?: string;
}

const { postCount, latestPostDate, noteCount, latestNoteDate, nowDescription } = Astro.props;

const pad = (n: number) => String(n).padStart(2, '0');
const hasNow = Boolean(nowDescription);
---

<!-- 卷首：几何构图 + 三格图例。图例只是计数，不是链接。 -->
<section class="frontispiece" aria-label="本册概览">
  <svg
    class="frontispiece__drawing"
    viewBox="0 0 960 200"
    role="presentation"
    aria-hidden="true"
  >
    <line x1="24" y1="24" x2="936" y2="24" stroke="var(--rule)" stroke-width="1"></line>
    <line x1="24" y1="176" x2="936" y2="176" stroke="var(--ink)" stroke-width="1"></line>
    <line x1="320" y1="24" x2="320" y2="176" stroke="var(--rule)" stroke-width="1"></line>
    <line x1="640" y1="24" x2="640" y2="176" stroke="var(--rule)" stroke-width="1"></line>
    <circle cx="160" cy="100" r="62" fill="none" stroke="var(--ink)" stroke-width="1.25"></circle>
    <circle
      cx="160"
      cy="100"
      r="31"
      fill="none"
      stroke="var(--ink)"
      stroke-width="1"
      opacity=".22"></circle>
    <rect x="418" y="38" width="124" height="124" fill="none" stroke="var(--ink)" stroke-width="1.25"
    ></rect>
    <polygon
      points="752,162 848,162 800,38"
      fill="none"
      stroke="var(--ink)"
      stroke-width="1.25"></polygon>
    <circle cx="222" cy="100" r="5.5" fill="var(--red)"></circle>
  </svg>

  <div class:list={['frontispiece__legend', !hasNow && 'frontispiece__legend--2']}>
    <span>
      <b>文章</b>
      {pad(postCount)} · {latestPostDate ? `最新 ${formatMonthDay(latestPostDate)}` : '暂无'}
    </span>
    <span>
      <b>碎碎念</b>
      {pad(noteCount)} · {latestNoteDate ? `最近 ${formatMonthDay(latestNoteDate)}` : '暂无'}
    </span>
    {hasNow && <span><b>现在</b> {nowDescription}</span>}
  </div>
</section>
