---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleHead from '../../components/ArticleHead.astro';
import SpecList from '../../components/SpecList.astro';
import { u } from '../../const';
import { getAdjacentPosts, getPostBySlug, getPostsForStaticPaths } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPostsForStaticPaths();
  return posts.map((post) => ({ params: { slug: post.id } }));
}

const { slug = '' } = Astro.params;
const includeDrafts = import.meta.env.DEV;

const post = await getPostBySlug(slug, { includeDrafts });
if (!post) return new Response('Not found', { status: 404 });

const { Content } = await render(post);
const { older, newer } = await getAdjacentPosts(post.id, { includeDrafts });
---

<Base size="compact" width="wide" ogType="article" title={post.data.title} description={post.data.description}>
  <article class="article-grid">
    <ArticleHead post={post} />
    <SpecList post={post} />

    <div class="prose">
      <Content />
    </div>

    <div class="article-end">
      <span class="article-end__label">本文完</span>
      <i aria-hidden="true"></i>
      {
        post.data.tags.length > 0 && (
          <span class="tag-list">
            {post.data.tags.map((tag) => (
              <a class="tag" href={u(`/tags/${encodeURIComponent(tag)}/`)}>
                {tag}
              </a>
            ))}
          </span>
        )
      }
    </div>

    <nav class="pager" aria-label="文章导航">
      <span>
        {
          older && (
            <a href={u(`/posts/${older.id}/`)}>
              <span class="pager__dir">更早</span>
              {older.data.title}
            </a>
          )
        }
      </span>
      <span style="text-align:right">
        {
          newer && (
            <a href={u(`/posts/${newer.id}/`)}>
              <span class="pager__dir">更新</span>
              {newer.data.title}
            </a>
          )
        }
      </span>
    </nav>
  </article>
</Base>
