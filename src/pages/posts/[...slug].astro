---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleHead from '../../components/ArticleHead.astro';
import SpecList from '../../components/SpecList.astro';
import { SITE, u } from '../../const';
import { getAdjacentPosts, getPostBySlug, getPostsForStaticPaths } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPostsForStaticPaths();
  return posts.map((post) => ({ params: { slug: post.id } }));
}

const { slug = '' } = Astro.params;
const includeDrafts = import.meta.env.DEV;

const post = await getPostBySlug(slug, { includeDrafts });
if (!post) return new Response('Not found', { status: 404 });

const { Content } = await render(post);
const { older, newer } = await getAdjacentPosts(post.id, { includeDrafts });

// ---------- P1e SEO：JSON-LD 与 article meta（契约见 docs/next-phase/p1e/README.md §3） ----------
const pubIso = post.data.pubDate.toISOString();
const modIso = (post.data.updatedDate ?? post.data.pubDate).toISOString();
const postCanonical = new URL(Astro.url.pathname, Astro.site).href;

// JSON-LD 字符串：< 统一转义为 \u003c，防止标题/描述里出现 </script> 逃逸（契约 §3.1）
const toLd = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');

const blogPostingLd = toLd({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  datePublished: pubIso,
  dateModified: modIso,
  author: { '@type': 'Person', name: SITE.author },
  keywords: post.data.tags,
  mainEntityOfPage: { '@type': 'WebPage', '@id': postCanonical },
});

// 面包屑三级：目录 → 首个标签 → 文章（标签顺序与印记外框同源）；无标签时退两级
const firstTag = post.data.tags[0];
const breadcrumbLd = toLd({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: SITE.title,
      item: new URL(u('/'), Astro.site).href,
    },
    ...(firstTag
      ? [
          {
            '@type': 'ListItem',
            position: 2,
            name: firstTag,
            item: new URL(u(`/tags/${encodeURIComponent(firstTag)}/`), Astro.site).href,
          },
        ]
      : []),
    {
      '@type': 'ListItem',
      position: firstTag ? 3 : 2,
      name: post.data.title,
      item: postCanonical,
    },
  ],
});
---

<Base size="compact" width="wide" ogType="article" title={post.data.title} description={post.data.description}>
  <Fragment slot="head">
    <meta property="article:published_time" content={pubIso} />
    <meta property="article:modified_time" content={modIso} />
    {post.data.tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
    <script type="application/ld+json" set:html={blogPostingLd} />
    <script type="application/ld+json" set:html={breadcrumbLd} />
  </Fragment>
  <article class="article-grid">
    <ArticleHead post={post} />
    <SpecList post={post} />

    <div class="prose">
      <Content />
    </div>

    <div class="article-end">
      <span class="article-end__label">本文完</span>
      <i aria-hidden="true"></i>
      {
        post.data.tags.length > 0 && (
          <span class="tag-list">
            {post.data.tags.map((tag) => (
              <a class="tag" href={u(`/tags/${encodeURIComponent(tag)}/`)}>
                {tag}
              </a>
            ))}
          </span>
        )
      }
    </div>

    <nav class="pager" aria-label="文章导航">
      <span>
        {
          older && (
            <a href={u(`/posts/${older.id}/`)}>
              <span class="pager__dir">更早</span>
              {older.data.title}
            </a>
          )
        }
      </span>
      <span style="text-align:right">
        {
          newer && (
            <a href={u(`/posts/${newer.id}/`)}>
              <span class="pager__dir">更新</span>
              {newer.data.title}
            </a>
          )
        }
      </span>
    </nav>
  </article>
</Base>
