---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { byNewest, formatDay, readingTime, u } from '../../const';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id } }));
}

const { slug } = Astro.params;

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(byNewest);
const index = posts.findIndex((p) => p.id === slug);
const post = posts[index];

const { Content } = await render(post);
const older = posts[index + 1];
const newer = index > 0 ? posts[index - 1] : undefined;
---

<Base size="compact" ogType="article" title={post.data.title} description={post.data.description}>
  <article>
    <header class="article__head">
      <p class="kicker">
        <a href={u('/')}>目录</a>
        /
        <a href={u('/tags/')}>标签</a>
      </p>
      <h1 class="article__title">{post.data.title}</h1>
      <p class="article__desc">{post.data.description}</p>
      <div class="article__meta">
        <span class="meta">{formatDay(post.data.pubDate)}{post.data.pubTime ? ` ${post.data.pubTime}` : ''} 发布</span>
        {
          post.data.updatedDate && (
            <span class="meta">更新于 {formatDay(post.data.updatedDate)}</span>
          )
        }
        <span class="meta">{readingTime(post.body)} 分钟读完</span>
        {
          post.data.tags.map((tag) => (
            <a class="tag" href={u(`/tags/${encodeURIComponent(tag)}/`)}>
              {tag}
            </a>
          ))
        }
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    <nav class="pager" aria-label="文章导航">
      <span>
        {
          older && (
            <a href={u(`/posts/${older.id}/`)}>
              <span class="pager__dir">更早</span>
              {older.data.title}
            </a>
          )
        }
      </span>
      <span style="text-align:right">
        {
          newer && (
            <a href={u(`/posts/${newer.id}/`)}>
              <span class="pager__dir">更新</span>
              {newer.data.title}
            </a>
          )
        }
      </span>
    </nav>
  </article>
</Base>
