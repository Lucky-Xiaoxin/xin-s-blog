---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { SITE, SOCIALS, resolveHref, u } from '../const';

// 「联系我」只列真联系方式；RSS 是订阅源不是联系方式，入口在页脚与 <head> 的
// alternate（N2）。页脚仍消费完整 SOCIALS（F12 收敛口径：页脚只有一个 RSS），这里只过滤展示。
const CONTACTS = SOCIALS.filter((s) => s.label !== 'RSS');
---

<Base size="compact" width="mid" active="about" title="关于">
  <PageHead kicker="关于 / ABOUT" title="关于我" />

  <p class="about-lead">
    我是 <strong>{SITE.author}</strong>，一名计算机专业的大二学生。这里是我用来整理课程笔记、题解和工具配置的地方——写给一年后（或者多年后）的自己看。
  </p>

  <div class="prose">
    <h2>这个博客写什么</h2>
    <ul>
      <li><strong>计算机系统</strong>：CSAPP、操作系统、网络协议里那些课件讲得不完整的地方</li>
      <li><strong>算法题解</strong>：周赛和刷题之后的小结，重点是模板之间的差异</li>
      <li><strong>开发工具</strong>：真正省下时间的配置，而不是清单式的推荐</li>
    </ul>
    <h2>这个站点</h2>
    <p>
      用 <a href="https://astro.build">Astro</a> 生成纯静态文件，Markdown 写在仓库里，推送到 GitHub 后由 Actions 自动构建并发布到
      GitHub Pages。订阅用 <a href={u('/rss.xml')}>RSS</a>。带日期的小事写在<a href={u('/notes/')}>碎碎念</a>里，当前状态在<a href={u('/now/')}>现在</a>。
    </p>
    <h2>联系我</h2>
    <p>
      站内 {SITE.handle} ·
      {
        CONTACTS.map((s, i) => (
          <>
            {i > 0 && ' · '}
            <a href={resolveHref(s.href)} rel={/^https?:/i.test(s.href) ? 'noopener' : undefined}>
              {s.label}
            </a>
          </>
        ))
      }
    </p>
  </div>
</Base>
