---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDay, isoDay, u } from '../const';
import { getNow } from '../lib/now';

const includeDrafts = import.meta.env.DEV;

const now = await getNow({ includeDrafts });
// 正文为空（首版）时不渲染 .now-body / .now-foot，只留页头 + 状态行
const hasBody = Boolean(now?.body?.trim());
const rendered = now && hasBody ? await render(now) : undefined;
const Content = rendered?.Content;
// 只有正文真的出现 h2 小节时才分两栏（README 的约定）
const hasSections = rendered?.headings.some((heading) => heading.depth === 2) ?? false;
---

<Base
  size="compact"
  width="mid"
  title="现在"
  description={now ? now.data.description : '这一页还没写。'}
>
  <header class="now-head">
    <p class="kicker">现在 / NOW</p>
    <h1>{now ? now.data.title : '现在'}</h1>
    <p class="now-lead">{now ? now.data.description : '这一页还没写。'}</p>
    {
      now && (
        <p class="now-status meta">
          <i aria-hidden="true" />
          <span>
            最后更新于 <time datetime={isoDay(now.data.updatedDate)}>{formatDay(now.data.updatedDate)}</time>
          </span>
          {now.data.draft && includeDrafts && (
            <span class="label" style="color:var(--red)">草稿预览</span>
          )}
        </p>
      )
    }
  </header>

  {
    now ? (
      Content && (
        <>
          <div class:list={['now-body', 'prose', hasSections && 'now-body--sections']}>
            <Content />
          </div>
          <p class="now-foot">
            这份状态每月更新一次。带日期的小事写在 → <a href={u('/notes/')}>碎碎念</a>
          </p>
        </>
      )
    ) : (
      <p class="empty-state">
        先去 <a href={u('/about/')}>关于</a> 或 <a href={u('/notes/')}>碎碎念</a>。
      </p>
    )
  }
</Base>
