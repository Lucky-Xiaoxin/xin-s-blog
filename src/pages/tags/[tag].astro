---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { u } from '../../const';
import { getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = new Set<string>();
  for (const post of posts) for (const tag of post.data.tags) tags.add(tag);
  return [...tags].map((tag) => ({ params: { tag } }));
}

const tag = Astro.params.tag!;

const posts = (await getPublishedPosts()).filter((post) => post.data.tags.includes(tag));
---

<Base size="compact" active="tags" title={`#${tag}`}>
  <p class="kicker">
    <a href={u('/tags/')}>标签</a>
    /
    {tag}
  </p>
  <h1 class="section-title">{tag}</h1>
  <p class="section-note">{posts.length} 篇文章</p>

  <PostList posts={posts} />
</Base>
