---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { formatDay, readingTime, u } from '../../const';
import { getPostsByTag, getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = new Set<string>();
  for (const post of posts) for (const tag of post.data.tags) tags.add(tag);
  return [...tags].map((tag) => ({ params: { tag } }));
}

const tag = Astro.params.tag!;
const posts = await getPostsByTag(tag);
const latest = posts[0];
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base
  size="compact"
  width="mid"
  active="tags"
  title={`#${tag}`}
  description={`标签 #${tag} 下的全部文章。`}
>
  <PageHead kicker="标签 / TAG" title={`#${tag}`} description={`${posts.length} 篇文章`}>
    {latest && <span class="meta">最近更新 {formatDay(latest.data.pubDate)}</span>}
  </PageHead>

  {
    posts.length === 0 ? (
      <p class="section-note">这个标签下还没有文章。</p>
    ) : (
      <section class="contents" aria-labelledby="tag-contents">
        <header class="section-head">
          <h2 id="tag-contents">目录</h2>
          <span class="meta">共 {posts.length} 篇 · 按时间倒序</span>
        </header>
        <ol class="toc">
          {posts.map((post, index) => (
            <li class="toc__item">
              <span class="toc__no">{pad(index + 1)}</span>
              <div>
                <h3>
                  <a href={u(`/posts/${post.id}/`)}>{post.data.title}</a>
                </h3>
                <p>{post.data.description}</p>
                {post.data.tags.length > 0 && (
                  <div class="toc__foot">
                    <span class="tag-list">
                      {post.data.tags.map((item) => (
                        <a class="tag" href={u(`/tags/${encodeURIComponent(item)}/`)}>
                          {item}
                        </a>
                      ))}
                    </span>
                  </div>
                )}
              </div>
              <div class="toc__meta">
                <span class="meta">
                  {formatDay(post.data.pubDate)}
                  {post.data.pubTime ? ` ${post.data.pubTime}` : ''}
                </span>
                <span class="meta">{readingTime(post.body)} 分钟</span>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )
  }
</Base>
