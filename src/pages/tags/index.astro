---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import { u } from '../../const';

const posts = await getCollection('posts', ({ data }) => !data.draft);

const grouped = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    grouped.set(tag, (grouped.get(tag) ?? 0) + 1);
  }
}
const tags = [...grouped.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh'),
);
---

<Base size="compact" active="tags" title="标签">
  <h1 class="section-title">标签</h1>
  <p class="section-note">
    {tags.length} 个标签 · 共 {posts.length} 篇文章
  </p>

  <ul class="tagcloud">
    {
      tags.map(([tag, count]) => (
        <li>
          <a href={u(`/tags/${encodeURIComponent(tag)}/`)}>
            <Badge tag={tag} />
            <span class="tagcloud__name">{tag}</span>
            <span class="tagcloud__count">{count}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
