---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import { u } from '../../const';
import { getAllTags, getPublishedPosts } from '../../lib/posts';

const [posts, tags] = await Promise.all([getPublishedPosts(), getAllTags()]);
---

<Base size="compact" active="tags" title="标签">
  <h1 class="section-title">标签</h1>
  <p class="section-note">
    {tags.length} 个标签 · 共 {posts.length} 篇文章
  </p>

  <ul class="tagcloud">
    {
      tags.map(({ tag, count }) => (
        <li>
          <a href={u(`/tags/${encodeURIComponent(tag)}/`)}>
            <Badge tag={tag} />
            <span class="tagcloud__name">{tag}</span>
            <span class="tagcloud__count">{count}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>
