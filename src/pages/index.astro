---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import PostList from '../components/PostList.astro';
import { byNewest, formatDay } from '../const';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(byNewest);

const latest = posts[0];
---

<Base active="home">
  <Hero>
    <div class="hero__caption">
      <span class="label">全部文章</span>
      <span class="meta">
        {posts.length} 篇 · 最近更新 {latest ? formatDay(latest.data.pubDate) : '—'}
      </span>
    </div>
  </Hero>

  <PostList posts={posts} />

  <p class="section-note" style="margin:3rem 0 0">
    没啦~
  </p>
</Base>
