---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import PostList from '../components/PostList.astro';
import { formatDay } from '../const';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const latest = posts[0];
---

<Base active="home">
  <Hero>
    <div class="hero__caption">
      <span class="label">全部文章</span>
      <span class="meta">
        {posts.length} 篇 · 最近更新 {latest ? formatDay(latest.data.pubDate) : '—'}
      </span>
    </div>
  </Hero>

  <PostList posts={posts} />

  <p class="section-note" style="margin:3rem 0 0">
    站名、作者与下面这 {posts.length} 篇都是占位示例，改 src/const.ts 和
    src/content/posts/ 就能换成你自己的内容。
  </p>
</Base>
