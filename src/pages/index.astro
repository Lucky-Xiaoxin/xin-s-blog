---
import Base from '../layouts/Base.astro';
import Contents from '../components/Contents.astro';
import Frontispiece from '../components/Frontispiece.astro';
import MarginNotes from '../components/MarginNotes.astro';
import Opening from '../components/Opening.astro';
import { getPublishedPosts } from '../lib/posts';
import { getPublishedNotes, getRecentNotes } from '../lib/notes';
import { getNow } from '../lib/now';

// 首页只算已发布：草稿不进图例、不进页边、不进目录
const posts = await getPublishedPosts();
const notes = await getPublishedNotes();
const recentNotes = await getRecentNotes(3);
const now = await getNow();

const latestPost = posts[0];
const latestNote = notes[0];
const nowDescription = now?.data.description;
const hasMargin = recentNotes.length > 0 || Boolean(nowDescription);
// 页边块缺席时 frontmatter 退回单列（开卷独占一行）
const singleColumn = Boolean(latestPost) !== hasMargin;
---

<Base active="home" size="full" width="wide">
  <Frontispiece
    postCount={posts.length}
    latestPostDate={latestPost?.data.pubDate}
    noteCount={notes.length}
    latestNoteDate={latestNote?.data.date}
    nowDescription={nowDescription}
  />

  <div class:list={['frontmatter', singleColumn && 'frontmatter--single']}>
    {latestPost && <Opening post={latestPost} />}
    {hasMargin && <MarginNotes notes={recentNotes} nowDescription={nowDescription} />}
    {!latestPost && !hasMargin && <p class="empty-state">还没写文章。</p>}
  </div>

  <Contents posts={posts} />
</Base>
